# Dependencies, test artifacts, and generated caches
node_modules/
test-results/
playwright-report/
blob-report/
.cache/
.npm/

# Environment files and local credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Local databases, dumps, and logs
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE and operating-system metadata
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Deployment-specific files are managed by the hosting environment.
.htaccess
robots.txt

# Proprietary font packages are intentionally not redistributed publicly.
assets/fonts/*
!assets/fonts/README.md

# The app loads the local Font Awesome subset only.
assets/icons/fontawesome/css/all.min.css
assets/icons/fontawesome/webfonts/fa-brands-400.woff2
assets/icons/fontawesome/webfonts/fa-v4compatibility.woff2
